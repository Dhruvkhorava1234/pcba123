<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent loop if request already points to public/
    RewriteCond %{REQUEST_URI} !^/public/

    # Direct static assets (images, css, js, fonts) to public folder if found there
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Send all other requests to public/index.php
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>

# Block direct access to sensitive files
<FilesMatch "^\.(env|git|editorconfig)">
    Order allow,deny
    Deny from all
</FilesMatch>
